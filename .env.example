# Copy to .env and fill in what you have. Everything is optional.
# Without OPENAI_API_KEY the app transcribes with the browser's speech recognition
# (when the browser supports it) or falls back to a clearly labelled demo transcript.
# Without ANTHROPIC_API_KEY the coach tip is rule-based and the role-play partner is scripted.

# Speech-to-text (OpenAI Whisper, used only when the user taps Analyse)
OPENAI_API_KEY=

# Coaching notes and role-play partner (Anthropic Claude)
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
ANTHROPIC_MODEL=

# Server
PORT=3000
# Max upload size for one recording, in megabytes
MAX_AUDIO_MB=20
